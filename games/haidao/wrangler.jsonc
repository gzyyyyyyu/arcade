// 海岛的独立配置：原样部署就是一个不要平台、谁打开都能玩的海岛
// （npm run deploy 得到 haidao.<子域>.workers.dev，打开 / 会转到 /games/haidao/）；没有登录和云存档。
// 本站正式部署时由总仓库的部署工具补上平台绑定 ARCADE 和 GATE=login，关掉 workers_dev，
// 注入路由（<站点>/games/haidao、<站点>/games/haidao/*）和 SITE_ORIGIN；这些都不写在这里。
// 异步攻防（DESIGN.md 第 5 节）：BASE 每人一个基地对象、HARBOR 全站一个匹配索引、METER 是共用包的写入计量；都是 SQLite 后端。
// 单独部署时这些也在，但没有平台认人，PvP 接口回 501，单机照常。
{
  "name": "haidao",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "BASE", "class_name": "Base" },
      { "name": "HARBOR", "class_name": "Harbor" },
      { "name": "METER", "class_name": "RoomMeter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Base", "Harbor", "RoomMeter"] }],
  // 悬赏出海（实盘）每人每天最多几场（北京时间，DESIGN.md 4.3）；不合法按 8
  "vars": { "HAIDAO_LIVE_DAILY": 8 },
  "assets": {
    "directory": "./dist-cf",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // 只有这些先过 Worker：站点根和 /api/me（单独部署时）、首页三种写法（登录闸门）、巡检的 health、游戏自己的接口；其余静态资源直接回
    "run_worker_first": ["/", "/api/me", "/games/haidao", "/games/haidao/", "/games/haidao/index.html", "/games/haidao/health", "/games/haidao/api/*"]
  }
}
