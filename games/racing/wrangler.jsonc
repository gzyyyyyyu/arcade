// racing Worker 的独立配置（docs/new-game.md 第 4、7 节；DESIGN.md 第 6 节）：页面 + 登录闸门 + 好友房。
// 别人拿到这个目录不要平台也能部署（kit 的独立模式：游客 cookie，任何人打开就能玩），npm run deploy 或 Deploy to Cloudflare 按钮。
// 接入 Arcade 平台时，部署工具在上面补平台绑定 ARCADE、GATE=login、路由和 SITE_ORIGIN，并关掉 workers_dev；
// 所以这里不写 services 和 GATE。
{
  "name": "racing",
  "main": "worker/main.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // 线上日志和调用记录（Workers Logs）：浏览器报错的原文也在这里按签名找（仓库根 docs/monitoring.md）
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist-cf",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // 只有这些先过 Worker：站点根和 /api/me（单独部署时）、首页（登录闸门）、巡检的 health、开房进房；其余静态资源直接回
    "run_worker_first": [
      "/", "/api/me", "/games/racing", "/games/racing/", "/games/racing/index.html",
      "/games/racing/health", "/games/racing/rooms", "/games/racing/rooms/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RacingRoom" },
      { "name": "METER", "class_name": "RoomMeter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RacingRoom", "RoomMeter"] }],
  "vars": {
    // 每天的 DO 写入预算（DESIGN.md 6.1，一房一场约 300 行）：到 busy 不开新房，到 stop 收场。数要维护者同意
    "KIT_QUOTA": { "busyWrites": 3000, "stopWrites": 4000, "roomsPerUser": 5, "dailyRoomsPerUser": 100 }
  }
}
